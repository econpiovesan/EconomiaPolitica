 setTimeout(()=>t.classList.remove("show"),2400);
}

const labs={
 market:{icon:"⚖️",title:"Trova il prezzo",sub:"Domanda, offerta e segnali di mercato"},
 tax:{icon:"🧾",title:"Chi paga la tassa?",sub:"Scopri come l’elasticità divide il peso fiscale"},
 commons:{icon:"🐟",title:"Il lago condiviso",sub:"Cinque pescatori, una risorsa che può finire"},
 strategy:{icon:"🤝",title:"Fidarsi o no?",sub:"Cinque round contro un avversario che ricorda"}
};
function openLab(type){
 showView("labView");
 const l=labs[type];
 document.getElementById("labContent").innerHTML=`
 <div class="lab-head"><span class="big">${l.icon}</span>
 <div><h1>${l.title}</h1><p>${l.sub}</p></div></div><div id="simArea"></div>`;
 if(type==="market")renderMarket();
 if(type==="tax")renderTax();
 if(type==="commons")renderCommons();
