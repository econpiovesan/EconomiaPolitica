<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SCELTE — Il laboratorio dell’economia</title>
<style>
:root{
  --ink:#18232c;--muted:#64717a;--paper:#fffdf8;--card:#fff;
  --line:#e7e2d8;--navy:#12324a;--yellow:#ffd84d;
  --coral:#ff6b5e;--mint:#54d6b0;--blue:#5aa7ff;
  --shadow:0 14px 40px rgba(18,50,74,.10)
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font:16px/1.55 ui-rounded,"SF Pro Rounded","Segoe UI",system-ui,sans-serif
}
button,input,textarea{font:inherit}
button{cursor:pointer}
.topbar{
  height:72px;display:flex;align-items:center;gap:24px;
  padding:0 clamp(18px,4vw,64px);position:sticky;top:0;z-index:20;
  background:rgba(255,253,248,.93);backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line)
}
.brand{
  border:0;background:none;font-weight:950;letter-spacing:.09em;
  font-size:1.18rem;color:var(--navy)
}
.brand span{
  display:inline-grid;place-items:center;width:29px;height:29px;
  margin-right:8px;border-radius:9px;background:var(--yellow);
  transform:rotate(-4deg)
}
.nav{display:flex;gap:7px;margin-left:auto}
.nav button{
  border:0;background:transparent;padding:10px 13px;border-radius:13px;
  color:var(--muted);font-weight:750
}
.nav button:hover,.nav button.active{background:#eef3f5;color:var(--navy)}
.progress-pill{
  display:flex;align-items:center;gap:8px;background:var(--navy);
  color:#fff;padding:8px 12px;border-radius:999px;font-size:.86rem;
  font-weight:800;white-space:nowrap
}
.progress-dot{width:9px;height:9px;border-radius:50%;background:var(--mint)}
main{max-width:1240px;margin:auto;padding:0 clamp(18px,4vw,54px) 80px}
.view{display:none}.view.active{display:block}
.hero{
  display:grid;grid-template-columns:1.15fr .85fr;gap:48px;
  align-items:center;min-height:590px;padding:70px 0 50px
}
.eyebrow{
  display:inline-flex;align-items:center;gap:9px;color:#355469;
  background:#eaf5f3;border:1px solid #cfe9e4;border-radius:999px;
  padding:7px 12px;font-weight:850;font-size:.84rem;
  text-transform:uppercase;letter-spacing:.06em
}
.hero h1{
  font-size:clamp(3rem,7vw,6.4rem);line-height:.91;
  letter-spacing:-.065em;margin:22px 0 24px;color:var(--navy)
}
.hero h1 em{font-style:normal;color:var(--coral);position:relative}
.hero h1 em:after{
  content:"";position:absolute;height:10px;left:2%;right:0;bottom:-8px;
  background:var(--yellow);border-radius:999px;transform:rotate(-1deg);z-index:-1
}
.hero-copy{font-size:1.16rem;color:#52636e;max-width:650px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.primary,.secondary{
  border:0;padding:14px 19px;border-radius:15px;font-weight:900;
  transition:.2s transform,.2s box-shadow
}
.primary{background:var(--navy);color:#fff;box-shadow:0 8px 0 #081e2d}
.secondary{background:#fff;color:var(--navy);border:2px solid var(--navy)}
.primary:hover,.secondary:hover{transform:translateY(-2px)}
.hero-visual{position:relative;min-height:420px;display:grid;place-items:center}
.orbit{
  width:360px;height:360px;border:2px dashed #b9c9cc;
  border-radius:50%;position:relative;animation:spin 35s linear infinite
}
@keyframes spin{to{transform:rotate(360deg)}}
.planet{
  position:absolute;display:grid;place-items:center;width:80px;height:80px;
  background:#fff;border:2px solid var(--ink);border-radius:22px;
  font-size:2.1rem;box-shadow:6px 7px 0 var(--ink);
  animation:counter 35s linear infinite
}
@keyframes counter{to{transform:rotate(-360deg)}}
.planet:nth-child(1){top:-20px;left:140px;background:var(--yellow)}
.planet:nth-child(2){top:135px;right:-24px;background:var(--mint)}
.planet:nth-child(3){bottom:-20px;left:140px;background:var(--blue)}
.planet:nth-child(4){top:135px;left:-24px;background:var(--coral)}
.center-coin{
  position:absolute;width:172px;height:172px;border-radius:50%;
  display:grid;place-items:center;text-align:center;background:var(--navy);
  color:#fff;border:9px solid #fff;box-shadow:var(--shadow);font-size:3.8rem
}
.center-coin small{
  font-size:.7rem;display:block;letter-spacing:.1em;
  text-transform:uppercase;font-weight:900;margin-top:-30px
}
.stats{
  display:grid;grid-template-columns:repeat(3,1fr);gap:14px;
  margin-top:-30px;margin-bottom:70px
}
.stat{
  padding:22px;background:#fff;border:1px solid var(--line);
  border-radius:20px;box-shadow:0 7px 20px rgba(18,50,74,.05)
}
.stat b{display:block;font-size:1.65rem;color:var(--navy)}
.stat span{color:var(--muted)}
.section-head{
  display:flex;justify-content:space-between;align-items:end;
  gap:22px;margin:55px 0 25px
}
.section-head h2{
  font-size:clamp(2rem,4vw,3.5rem);line-height:1;
  letter-spacing:-.045em;margin:0;color:var(--navy)
}
.section-head p{color:var(--muted);max-width:480px;margin:0}
.toolbar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:22px}
.search{flex:1;min-width:220px;position:relative}
.search span{position:absolute;left:15px;top:11px}
.search input{
  width:100%;padding:12px 15px 12px 44px;border:1px solid var(--line);
  border-radius:14px;background:#fff;outline:none
}
.search input:focus{border-color:var(--blue);box-shadow:0 0 0 4px rgba(90,167,255,.14)}
.filters{display:flex;gap:7px;flex-wrap:wrap}
.chip{
  border:1px solid var(--line);background:#fff;padding:9px 12px;
  border-radius:999px;font-size:.87rem;font-weight:800;color:var(--muted)
}
.chip.active{color:var(--navy);background:var(--yellow);border-color:#e0bc29}
.module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.module-card{
  min-height:270px;background:#fff;border:1px solid var(--line);
  border-radius:24px;padding:24px;display:flex;flex-direction:column;
  position:relative;overflow:hidden;transition:.22s transform,.22s box-shadow
}
.module-card:before{
  content:"";position:absolute;width:125px;height:125px;border-radius:50%;
  right:-45px;top:-50px;background:var(--accent);opacity:.18
}
.module-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
.module-top{display:flex;justify-content:space-between;align-items:center;position:relative}
.module-icon{
  width:49px;height:49px;border-radius:15px;background:var(--accent);
  display:grid;place-items:center;font-size:1.55rem;border:1.5px solid var(--ink);
  box-shadow:3px 3px 0 var(--ink)
}
.done-badge{
  font-size:.75rem;font-weight:900;color:#13755c;background:#def8ef;
  padding:5px 8px;border-radius:999px
}
.module-card h3{
  font-size:1.38rem;line-height:1.1;margin:25px 0 10px;
  color:var(--navy);letter-spacing:-.02em
}
.module-card p{color:var(--muted);margin:0 0 20px}
.module-meta{
  display:flex;align-items:center;justify-content:space-between;
  margin-top:auto;color:#71808a;font-size:.85rem
}
.open-link{border:0;background:transparent;color:var(--navy);font-weight:900}
.lab-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.lab-card{
  min-height:260px;border-radius:28px;padding:30px;color:#fff;
  position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:flex-start
}
.lab-card:nth-child(1){background:#12324a}
.lab-card:nth-child(2){background:#705ed4}
.lab-card:nth-child(3){background:#147b65}
.lab-card:nth-child(4){background:#d94f43}
.lab-card:after{
  content:"";position:absolute;width:210px;height:210px;
  border:32px solid rgba(255,255,255,.1);border-radius:50%;
  right:-70px;bottom:-95px
}
.lab-card .emoji{font-size:2.4rem}
.lab-card h3{font-size:1.6rem;line-height:1.1;margin:16px 0 9px}
.lab-card p{opacity:.84;max-width:75%;margin:0 0 22px}
.lab-card button{
  margin-top:auto;border:0;padding:11px 15px;border-radius:12px;
  font-weight:900;color:var(--navy);z-index:1
}
.teacher{
  margin-top:70px;background:#fff1b8;border:2px solid var(--ink);
  box-shadow:8px 8px 0 var(--ink);border-radius:30px;padding:35px;
  display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center
}
.teacher h2{font-size:2rem;line-height:1;margin:0 0 12px}
.teacher p{margin:0;max-width:760px;color:#525d62}
.teacher button{
  border:0;background:var(--ink);color:#fff;border-radius:14px;
  padding:14px 18px;font-weight:900
}
footer{
  padding:35px 0 0;color:var(--muted);display:flex;
  justify-content:space-between;border-top:1px solid var(--line);margin-top:80px
}
.lesson,.lab-view{padding-top:42px}
.back{
  border:0;background:#eef3f5;color:var(--navy);
  font-weight:900;padding:10px 14px;border-radius:12px
}
.lesson-hero{
  margin-top:22px;border-radius:32px;padding:36px;
  display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center;
  border:2px solid var(--ink);box-shadow:8px 8px 0 var(--ink);
  background:var(--lesson)
}
.lesson-big-icon{
  width:100px;height:100px;border-radius:28px;background:rgba(255,255,255,.7);
  display:grid;place-items:center;font-size:3.3rem;border:2px solid var(--ink)
}
.lesson-hero h1{
  font-size:clamp(2rem,5vw,4.3rem);line-height:.95;
  letter-spacing:-.05em;color:var(--navy);margin:6px 0 8px
}
.lesson-hero p{margin:0;color:#354854;max-width:700px}
.lesson-count{
  font-weight:900;color:var(--navy);background:#fff;
  padding:9px 13px;border-radius:999px;align-self:start
}
.lesson-tabs{
  display:flex;gap:8px;margin:32px 0 22px;overflow:auto;padding-bottom:5px
}
.lesson-tab{
  border:1px solid var(--line);background:#fff;border-radius:13px;
  padding:11px 14px;font-weight:850;color:var(--muted);white-space:nowrap
}
.lesson-tab.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.lesson-pane{display:none}.lesson-pane.active{display:block}
.content-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:22px}
.paper{
  background:#fff;border:1px solid var(--line);
  border-radius:24px;padding:28px
}
.paper h2,.paper h3{color:var(--navy);margin-top:0}
.lead{font-size:1.16rem;color:#40535f}
.concept-list{display:grid;gap:12px;margin:22px 0}
.concept{
  padding:17px;border-radius:17px;background:#f5f7f6;
  display:flex;gap:12px
}
.concept b{color:var(--navy)}
.concept-num{
  flex:none;width:29px;height:29px;border-radius:9px;background:var(--lesson);
  display:grid;place-items:center;font-weight:950
}
.example{
  background:#eaf5f3;border-left:5px solid var(--mint);
  padding:20px;border-radius:4px 18px 18px 4px;margin-top:20px
}
.example strong{display:block;margin-bottom:6px;color:var(--navy)}
.side-note{background:var(--navy);color:#fff}
.side-note h3{color:#fff}.side-note p{opacity:.84}
.key{
  display:inline-block;background:var(--yellow);color:var(--ink);
  font-weight:900;padding:4px 8px;border-radius:8px;margin:3px
}
.challenge{
  background:#fff;border:1px solid var(--line);
  border-radius:24px;padding:30px
}
.challenge-label{
  color:#966700;text-transform:uppercase;letter-spacing:.09em;
  font-weight:950;font-size:.8rem
}
.challenge h2{font-size:2rem;line-height:1.15;color:var(--navy)}
.answer-box{
  width:100%;min-height:120px;border:2px solid var(--line);
  border-radius:15px;padding:15px;resize:vertical;outline:none
}
.model-answer{
  display:none;margin-top:15px;padding:17px;border-radius:15px;background:#f1f7f5
}
.model-answer.show{display:block}
.activity-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.activity{
  background:#fff;border:1px solid var(--line);
  border-radius:24px;padding:28px
}
.activity.family{border-top:8px solid var(--coral)}
.activity.classroom{border-top:8px solid var(--blue)}
.activity .tag{
  font-weight:950;text-transform:uppercase;letter-spacing:.08em;font-size:.78rem
}
.activity h2{color:var(--navy)}
.steps{padding-left:21px}.steps li{margin:9px 0}
.quiz{
  max-width:760px;margin:auto;background:#fff;border:1px solid var(--line);
  border-radius:28px;padding:34px
}
.quiz h2{color:var(--navy);font-size:2rem;line-height:1.15}
.options{display:grid;gap:11px}
.option{
  border:2px solid var(--line);background:#fff;text-align:left;
  padding:15px 17px;border-radius:15px;font-weight:750;color:var(--ink)
}
.option.correct{background:#dcf7ed;border-color:#31a982}
.option.wrong{background:#ffe4e1;border-color:#e75d50}
.quiz-feedback{min-height:54px;padding:13px 0;color:var(--muted)}
.quiz-actions{display:flex;justify-content:space-between;align-items:center;gap:10px}
.complete{display:none}.complete.show{display:inline-block}
.lab-head{display:flex;gap:18px;align-items:center;margin:25px 0}
.lab-head .big{font-size:3rem}
.lab-head h1{
  font-size:clamp(2.2rem,5vw,4rem);line-height:1;
  margin:0;color:var(--navy);letter-spacing:-.05em
}
.lab-head p{margin:8px 0 0;color:var(--muted)}
.sim-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:22px}
.controls,.screen{
  background:#fff;border:1px solid var(--line);
  border-radius:24px;padding:27px
}
.controls h3,.screen h3{margin-top:0;color:var(--navy)}
.control{margin:23px 0}
.control label{font-weight:850;display:flex;justify-content:space-between;margin-bottom:9px}
.control input[type=range]{width:100%;accent-color:var(--coral)}
.readouts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.readout{padding:15px;border-radius:15px;background:#f2f5f5}
.readout b{display:block;font-size:1.45rem;color:var(--navy)}
.status{
  margin-top:15px;padding:15px;border-radius:15px;
  background:#fff4c9;font-weight:800
}
canvas{width:100%;height:320px;background:#fbfbf8;border-radius:16px}
.choice-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:17px}
.choice-row button{
  border:2px solid var(--navy);background:#fff;padding:12px 17px;
  border-radius:13px;font-weight:900;color:var(--navy)
}
.choice-row button:hover{background:var(--yellow)}
.game-log{margin-top:18px;display:grid;gap:8px;max-height:260px;overflow:auto}
.log-row{
  display:grid;grid-template-columns:70px 1fr auto;gap:10px;
  padding:11px;background:#f5f7f6;border-radius:12px;font-size:.9rem
}
.resource-bar{
  height:25px;background:#e8eeec;border-radius:999px;
  overflow:hidden;margin:18px 0
}
.resource-fill{
  height:100%;background:linear-gradient(90deg,#54d6b0,#16896e);
  transition:.4s width
}
.payoff{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0}
.payoff div{padding:13px;border-radius:12px;background:#f1f4f5;font-size:.88rem}
.result-box{
  padding:18px;border-radius:16px;background:#eef3f5;
  margin-top:15px;min-height:64px
}
.score-ring{
  width:140px;height:140px;border-radius:50%;display:grid;
  place-items:center;margin:15px auto;
  background:conic-gradient(var(--mint) var(--score),#edf0ef 0);
  position:relative
}
.score-ring:after{
  content:"";position:absolute;inset:13px;background:#fff;border-radius:50%
}
.score-ring b{z-index:1;font-size:2rem;color:var(--navy)}
.toast{
  position:fixed;left:50%;bottom:25px;transform:translate(-50%,120px);
  background:var(--ink);color:#fff;padding:12px 18px;border-radius:13px;
  font-weight:800;transition:.3s;z-index:50
}
.toast.show{transform:translate(-50%,0)}
@media(max-width:900px){
  .hero{grid-template-columns:1fr;padding-top:50px}
  .hero-visual{display:none}.stats{margin-top:0}
  .module-grid{grid-template-columns:repeat(2,1fr)}
  .content-grid,.sim-grid{grid-template-columns:1fr}
  .lesson-hero{grid-template-columns:auto 1fr}
  .lesson-count{display:none}
}
@media(max-width:620px){
  .topbar{height:64px;padding:0 16px}
  .nav button{display:none}.nav button:first-child{display:block}
  .progress-pill{font-size:0;padding:10px}
  .hero{min-height:auto;padding:48px 0 35px}.hero h1{font-size:3.7rem}
  .stats,.module-grid,.lab-grid,.activity-grid{grid-template-columns:1fr}
  .section-head{align-items:start;flex-direction:column}
  .teacher{grid-template-columns:1fr}
  .lesson-hero{padding:23px;grid-template-columns:1fr}
  .lesson-big-icon{width:72px;height:72px;font-size:2.3rem}
  .paper,.quiz,.challenge{padding:22px}
  .readouts{grid-template-columns:1fr}
  .lab-card p{max-width:100%}
  footer{flex-direction:column;gap:8px}
}
@media(prefers-reduced-motion:reduce){
  *{scroll-behavior:auto!important;animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<header class="topbar">
  <button class="brand" onclick="goHome()"><span>↗</span>SCELTE</button>
  <nav class="nav">
    <button class="active" onclick="goHome()">Esplora</button>
    <button onclick="goSection('percorsi')">Percorsi</button>
    <button onclick="goSection('laboratori')">Laboratori</button>
    <button onclick="goSection('attivita')">Per adulti</button>
  </nav>
  <div class="progress-pill">
    <span class="progress-dot"></span>
    <span id="progressText">0/16 completati</span>
  </div>
</header>

<main>
<section id="homeView" class="view active">
  <div class="hero">
    <div>
      <span class="eyebrow">⚡ Economia, senza formule inutili</span>
      <h1>Ogni scelta<br>muove il <em>mondo.</em></h1>
      <p class="hero-copy">
        Perché un biglietto costa di più proprio quando lo vuoi?
        Chi paga davvero una tassa? Perché collaboriamo — o non lo facciamo?
        Scopri l’economia che incontri ogni giorno.
      </p>
      <div class="hero-actions">
        <button class="primary" onclick="startJourney()">Inizia dal primo tema →</button>
        <button class="secondary" onclick="goSection('laboratori')">Prova un gioco</button>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="orbit">
        <div class="planet">🛒</div><div class="planet">🏭</div>
        <div class="planet">🌍</div><div class="planet">🎲</div>
      </div>
      <div class="center-coin">€<small>le tue scelte</small></div>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><b>16 temi</b><span>dalle scelte ai giochi strategici</span></div>
    <div class="stat"><b>4 laboratori</b><span>per imparare provando</span></div>
    <div class="stat"><b>0 paura</b><span>parole chiare, esempi concreti</span></div>
  </div>

  <section id="percorsi">
    <div class="section-head">
      <div><span class="eyebrow">Il percorso</span><h2>Un’idea alla volta.</h2></div>
      <p>Segui l’ordine suggerito oppure parti dalla domanda che ti incuriosisce di più.</p>
    </div>
    <div class="toolbar">
      <label class="search">
        <span>⌕</span>
        <input id="searchInput" placeholder="Cerca: prezzi, tasse, lavoro…" oninput="renderModules()">
      </label>
      <div class="filters" id="filters"></div>
    </div>
    <div class="module-grid" id="moduleGrid"></div>
  </section>

  <section id="laboratori">
    <div class="section-head">
      <div><span class="eyebrow">Impara facendo</span><h2>Laboratori interattivi.</h2></div>
      <p>Sposta cursori, prendi decisioni e osserva cosa cambia. Qui sbagliare è parte del gioco.</p>
    </div>
    <div class="lab-grid">
      <article class="lab-card">
        <span class="emoji">⚖️</span><h3>Trova il prezzo</h3>
        <p>Porta domanda e offerta verso l’equilibrio.</p>
        <button onclick="openLab('market')">Apri il mercato →</button>
      </article>
      <article class="lab-card">
        <span class="emoji">🧾</span><h3>Chi paga la tassa?</h3>
        <p>Osserva come l’elasticità divide il peso fiscale.</p>
        <button onclick="openLab('tax')">Apri il simulatore →</button>
      </article>
      <article class="lab-card">
        <span class="emoji">🐟</span><h3>Il lago condiviso</h3>
        <p>Pesca, ma lascia che la risorsa possa rigenerarsi.</p>
        <button onclick="openLab('commons')">Vai al lago →</button>
      </article>
      <article class="lab-card">
        <span class="emoji">🤝</span><h3>Fidarsi o no?</h3>
        <p>Gioca cinque round e scopri come nasce la cooperazione.</p>
        <button onclick="openLab('strategy')">Sfida il computer →</button>
      </article>
    </div>
