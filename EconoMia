}
function renderMarket(){
 document.getElementById("simArea").innerHTML=`
 <div class="sim-grid">
  <div class="controls">
   <h3>Il tuo comando</h3>
   <div class="control"><label>Prezzo della borraccia <b id="pLabel">€12</b></label>
   <input id="price" type="range" min="2" max="22" value="12" oninput="updateMarket()"></div>
   <p>Muovi il prezzo. Cerca di far coincidere quante borracce le persone vogliono comprare e quante le imprese vogliono vendere.</p>
   <div class="status" id="marketStatus"></div>
  </div>
  <div class="screen">
   <h3>Il mercato in diretta</h3><canvas id="marketCanvas" width="700" height="320"></canvas>
   <div class="readouts">
    <div class="readout">Domanda<b id="qd">–</b></div>
    <div class="readout">Offerta<b id="qs">–</b></div>
    <div class="readout">Differenza<b id="gap">–</b></div>
   </div>
  </div>
 </div>`;
 updateMarket();
}
function updateMarket(){
 const p=+document.getElementById("price").value;
 const qd=Math.max(0,120-5*p),qs=Math.max(0,10+5*p),gap=qs-qd;
 pLabel.textContent=`€${p}`;document.getElementById("qd").textContent=qd;
 document.getElementById("qs").textContent=qs;document.getElementById("gap").textContent=Math.abs(gap);
 document.getElementById("marketStatus").innerHTML=Math.abs(gap)<=5
  ?"🎯 <b>Equilibrio!</b> Il prezzo coordina i due lati."
  :gap>0?`📦 <b>Eccedenza di ${gap}.</b> Il prezzo è troppo alto.`
  :`🏃 <b>Scarsità di ${-gap}.</b> Il prezzo è troppo basso.`;
 drawMarket(p);
}
function drawMarket(p){
 const c=document.getElementById("marketCanvas"),x=c.getContext("2d"),W=c.width,H=c.height;
 x.clearRect(0,0,W,H);x.strokeStyle="#dfe6e5";x.lineWidth=1;
 for(let i=1;i<6;i++){x.beginPath();x.moveTo(50,i*45);x.lineTo(W-30,i*45);x.stroke()}
 x.strokeStyle="#18232c";x.lineWidth=3;x.beginPath();
 x.moveTo(50,20);x.lineTo(50,H-35);x.lineTo(W-30,H-35);x.stroke();
 x.strokeStyle="#ff6b5e";x.lineWidth=6;x.beginPath();x.moveTo(70,40);x.lineTo(W-50,H-55);x.stroke();
 x.strokeStyle="#54d6b0";x.beginPath();x.moveTo(70,H-55);x.lineTo(W-50,40);x.stroke();
 const y=H-35-(p/24)*(H-60);
 x.setLineDash([8,7]);x.strokeStyle="#12324a";x.lineWidth=3;
 x.beginPath();x.moveTo(50,y);x.lineTo(W-30,y);x.stroke();x.setLineDash([]);
 x.fillStyle="#12324a";x.font="bold 20px system-ui";x.fillText(`€${p}`,8,y+6);
 x.fillStyle="#ff6b5e";x.fillText("D",W-75,H-70);
 x.fillStyle="#16896e";x.fillText("O",W-75,55);
}
function renderTax(){
 document.getElementById("simArea").innerHTML=`
 <div class="sim-grid">
  <div class="controls"><h3>Imposta il mercato</h3>
   <div class="control"><label>Tassa per unità <b id="taxLabel">€4</b></label>
   <input id="taxVal" type="range" min="0" max="10" value="4" oninput="updateTax()"></div>
   <div class="control"><label>Elasticità della domanda <b id="edLabel">1.0</b></label>
   <input id="edVal" type="range" min="2" max="20" value="10" oninput="updateTax()"></div>
   <div class="control"><label>Elasticità dell’offerta <b id="esLabel">1.0</b></label>
   <input id="esVal" type="range" min="2" max="20" value="10" oninput="updateTax()"></div>
   <p>Un valore basso indica poca capacità di reagire: quel lato rimane più bloccato nel mercato.</p>
  </div>
  <div class="screen"><h3>Come si divide il peso</h3>
   <div class="score-ring" id="taxRing" style="--score:50%"><b id="consumerPct">50%</b></div>
   <div class="readouts">
    <div class="readout">Consumatori<b id="consumerPay">€2,00</b></div>
    <div class="readout">Produttori<b id="producerPay">€2,00</b></div>
    <div class="readout">Tassa totale<b id="taxTotal">€4,00</b></div>
   </div><div class="status" id="taxStatus"></div>
  </div>
 </div>`;
 updateTax();
}
function updateTax(){
 const tax=+taxVal.value,ed=+edVal.value/10,es=+esVal.value/10;
 const cp=es/(es+ed),pp=1-cp;
 taxLabel.textContent=`€${tax}`;edLabel.textContent=ed.toFixed(1);esLabel.textContent=es.toFixed(1);
 consumerPct.textContent=`${Math.round(cp*100)}%`;
 taxRing.style.setProperty("--score",`${cp*100}%`);
 consumerPay.textContent=`€${(tax*cp).toFixed(2).replace(".",",")}`;
 producerPay.textContent=`€${(tax*pp).toFixed(2).replace(".",",")}`;
 taxTotal.textContent=`€${tax.toFixed(2).replace(".",",")}`;
 taxStatus.innerHTML=cp>.58
  ?"🧍 La domanda è relativamente meno elastica: i consumatori sopportano più peso."
  :cp<.42?"🏭 L’offerta è relativamente meno elastica: i produttori sopportano più peso."
  :"⚖️ Le elasticità sono simili: il peso è quasi diviso a metà.";
}

let lake={round:1,fish:60,score:0,log:[]};
function renderCommons(){
 lake={round:1,fish:60,score:0,log:[]};
 document.getElementById("simArea").innerHTML=`
 <div class="sim-grid">
  <div class="controls"><h3>Regole del lago</h3>
   <p>Siete in cinque. A ogni round scegli quanti pesci prendere. I pesci rimasti si riproducono del 35%, fino a un massimo di 60.</p>
   <div class="resource-bar"><div class="resource-fill" id="fishFill"></div></div>
   <div class="readouts">
    <div class="readout">Round<b id="lakeRound">1/6</b></div>
    <div class="readout">Pesci<b id="fishCount">60</b></div>
    <div class="readout">Il tuo totale<b id="lakeScore">0</b></div>
   </div>
   <div class="choice-row">
    <button onclick="fish(2)">Prendine 2</button>
    <button onclick="fish(5)">Prendine 5</button>
    <button onclick="fish(9)">Prendine 9</button>
   </div>
   <div class="result-box" id="lakeResult">Pescare molto aiuta oggi, ma riduce la risorsa di domani.</div>
  </div>
  <div class="screen"><h3>Diario della pesca</h3>
   <div class="game-log" id="lakeLog"><p>Le decisioni compariranno qui.</p></div>
  </div>
 </div>`;
 updateLake();
}
function fish(mine){
 if(lake.round>6||lake.fish<=0)return;
 const others=[0,0,0,0].map(()=>lake.fish<25?2:(Math.random()<.55?5:9));
 const wanted=mine+others.reduce((a,b)=>a+b,0);
 const actual=Math.min(lake.fish,wanted),ratio=actual/wanted;
 const myCatch=Math.round(mine*ratio*10)/10;
 lake.fish-=actual;lake.score+=myCatch;
 lake.fish=Math.min(60,Math.round(lake.fish*1.35));
 lake.log.unshift({r:lake.round,mine:myCatch,others:Math.round((actual-myCatch)*10)/10,left:lake.fish});
 lake.round++;
 lakeResult.innerHTML=lake.fish<=0
  ?"💥 <b>Il lago è esaurito.</b> Nessuno potrà pescare nei prossimi round."
  :`Hai preso <b>${myCatch}</b>. Gli altri ${Math.round((actual-myCatch)*10)/10}. Dopo la riproduzione: <b>${lake.fish}</b> pesci.`;
 if(lake.round>6&&lake.fish>0)lakeResult.innerHTML+=`<br>🏁 Fine: hai raccolto ${lake.score.toFixed(1)}, lasciando ${lake.fish} pesci.`;
 updateLake();
}
function updateLake(){
 fishFill.style.width=`${lake.fish/60*100}%`;
 lakeRound.textContent=`${Math.min(lake.round,6)}/6`;
 fishCount.textContent=lake.fish;lakeScore.textContent=lake.score.toFixed(1);
 lakeLog.innerHTML=lake.log.length?lake.log.map(x=>`
 <div class="log-row"><b>Round ${x.r}</b><span>Tu ${x.mine} · Altri ${x.others}</span><span>Restano ${x.left}</span></div>`
 ).join(""):"<p>Le decisioni compariranno qui.</p>";
}

let game={round:1,you:0,cpu:0,last:null,log:[]};
function renderStrategy(){
 game={round:1,you:0,cpu:0,last:null,log:[]};
 document.getElementById("simArea").innerHTML=`
 <div class="sim-grid">
  <div class="controls"><h3>La scelta</h3>
   <p>Se collaborate entrambi: 3 punti ciascuno. Se uno approfitta dell’altro: 5 a chi tradisce, 0 a chi collabora. Se tradite entrambi: 1 punto ciascuno.</p>
   <div class="payoff">
    <div>🤝 + 🤝<br><b>3 · 3</b></div><div>🤝 + 🐍<br><b>0 · 5</b></div>
    <div>🐍 + 🤝<br><b>5 · 0</b></div><div>🐍 + 🐍<br><b>1 · 1</b></div>
   </div>
   <div class="choice-row">
    <button onclick="playStrategy('C')">🤝 Collaboro</button>
    <button onclick="playStrategy('D')">🐍 Penso a me</button>
   </div>
   <div class="result-box" id="strategyResult">Round 1: il computer osserva le tue scelte passate.</div>
  </div>
  <div class="screen"><h3>Punteggio</h3>
   <div class="readouts">
    <div class="readout">Tu<b id="youScore">0</b></div>
    <div class="readout">Computer<b id="cpuScore">0</b></div>
    <div class="readout">Round<b id="gameRound">1/5</b></div>
   </div><div class="game-log" id="strategyLog"></div>
  </div>
 </div>`;
}
function playStrategy(choice){
 if(game.round>5)return;
 const cpu=game.round===1?"C":(Math.random()<.8?game.last:(game.last==="C"?"D":"C"));
 let yp,cp;
 if(choice==="C"&&cpu==="C"){yp=3;cp=3}
 else if(choice==="D"&&cpu==="C"){yp=5;cp=0}
 else if(choice==="C"&&cpu==="D"){yp=0;cp=5}
 else{yp=1;cp=1}
 game.you+=yp;game.cpu+=cp;game.last=choice;
 game.log.unshift({r:game.round,choice,cpu,yp,cp});game.round++;
 youScore.textContent=game.you;cpuScore.textContent=game.cpu;
 gameRound.textContent=`${Math.min(game.round,5)}/5`;
 strategyLog.innerHTML=game.log.map(x=>`
 <div class="log-row"><b>Round ${x.r}</b>
 <span>Tu ${x.choice==="C"?"🤝":"🐍"} · Computer ${x.cpu==="C"?"🤝":"🐍"}</span>
 <span>${x.yp} · ${x.cp}</span></div>`).join("");
 strategyResult.innerHTML=game.round>5
  ?`🏁 <b>Fine: ${game.you} a ${game.cpu}.</b> Nei giochi ripetuti, reputazione e reciprocità possono sostenere la cooperazione.`
  :`Il computer ha scelto ${cpu==="C"?"di collaborare 🤝":"di pensare a sé 🐍"}. Tu +${yp}, lui +${cp}.`;
}

