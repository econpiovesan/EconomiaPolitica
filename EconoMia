function switchTab(name,btn){
 document.querySelectorAll(".lesson-tab").forEach(b=>b.classList.remove("active"));
 btn.classList.add("active");
 document.querySelectorAll(".lesson-pane").forEach(p=>p.classList.toggle("active",p.dataset.pane===name));
}
function clickTab(name){
 const btn=[...document.querySelectorAll(".lesson-tab")].find(b=>b.getAttribute("onclick").includes(`'${name}'`));
 switchTab(name,btn);
 window.scrollTo({top:250,behavior:"smooth"});
}
function answerQuiz(idx){
 if(selectedAnswer!==null)return;
 selectedAnswer=idx;
 const m=modules[currentModule];
 document.querySelectorAll(".option").forEach((b,j)=>{
  if(j===m.correct)b.classList.add("correct");
  else if(j===idx)b.classList.add("wrong");
  b.disabled=true;
 });
 document.getElementById("quizFeedback").innerHTML=idx===m.correct
  ?`<b>✓ Risposta corretta.</b> ${m.feedback}`
  :`<b>Non proprio.</b> La risposta corretta è <b>${"ABCD"[m.correct]}</b>. ${m.feedback}`;
 document.getElementById("nextButton").classList.add("show");
}
function finishAndNext(){
 completed.add(currentModule);
 localStorage.setItem("scelte-completed",JSON.stringify([...completed]));
 updateProgress();toast("Tema completato! Progresso salvato.");
 openLesson((currentModule+1)%modules.length);
}
function toast(msg){
